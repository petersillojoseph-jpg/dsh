{
  "name": "@local/grokbot-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test src/client/bots/nav.test.js src/client/bots/list-model.test.js src/client/bots/layout-regression.test.js src/client/bots/review-fixes.test.js browser-extension/extension.test.js",
    "build": "node build.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.css",
    "data/*.json",
    "locale/*.json",
    "icon.svg",
    "LICENSES/**",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "dependencies": {
    "@openuidev/lang-core": "^1.2.0",
    "@openuidev/react-lang": "^1.2.0",
    "@openuidev/react-ui": "^0.19.0"
  }
}
